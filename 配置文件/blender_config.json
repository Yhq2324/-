{
  "description": "Blender点云处理配置文件",
  "author": "Claude AI",
  "version": "1.0",

  "point_cloud_analysis": {
    "enabled": true,
    "output_format": "json",
    "quality_thresholds": {
      "excellent": 80,
      "good": 60,
      "acceptable": 40,
      "poor": 0
    }
  },

  "point_cloud_cleaning": {
    "remove_duplicates": {
      "enabled": true,
      "threshold": 0.001,
      "comment": "距离小于0.001单位的点视为重复"
    },
    "remove_outliers": {
      "enabled": true,
      "method": "statistical",
      "std_dev_multiplier": 3.0,
      "comment": "移除距离>平均值+3倍标准差的点"
    },
    "downsample": {
      "enabled": true,
      "default_ratio": 0.5,
      "adaptive": true,
      "rules": {
        "very_large": {
          "point_count": 50000000,
          "ratio": 0.2,
          "comment": ">5000万点，保留20%"
        },
        "large": {
          "point_count": 10000000,
          "ratio": 0.3,
          "comment": "1000-5000万点，保留30%"
        },
        "medium": {
          "point_count": 1000000,
          "ratio": 0.5,
          "comment": "100-1000万点，保留50%"
        },
        "small": {
          "point_count": 100000,
          "ratio": 0.8,
          "comment": "<100万点，保留80%"
        }
      }
    },
    "smooth": {
      "enabled": false,
      "factor": 0.5,
      "iterations": 2,
      "comment": "平滑可能导致细节丢失，默认关闭"
    }
  },

  "mesh_reconstruction": {
    "method": "poisson",
    "poisson": {
      "depth": 9,
      "comment": "深度越高质量越好但速度越慢，范围6-12"
    },
    "ball_pivoting": {
      "radius": 0.05,
      "comment": "备选方法，适合均匀点云"
    }
  },

  "mesh_optimization": {
    "decimate": {
      "enabled": true,
      "target_poly_count": 50000,
      "comment": "目标面数，适合游戏引擎"
    },
    "remesh": {
      "enabled": false,
      "voxel_size": 0.01,
      "comment": "体素重网格，可选"
    }
  },

  "uv_unwrap": {
    "method": "smart_project",
    "smart_project": {
      "angle_limit": 66.0,
      "island_margin": 0.02,
      "comment": "智能UV投影，自动展开"
    }
  },

  "texture_baking": {
    "normal_map": {
      "enabled": true,
      "resolution": 2048,
      "comment": "法线贴图保留细节"
    },
    "ao_map": {
      "enabled": true,
      "resolution": 2048,
      "samples": 128,
      "comment": "环境光遮蔽贴图"
    },
    "roughness_map": {
      "enabled": false,
      "resolution": 1024,
      "comment": "粗糙度贴图，可选"
    }
  },

  "export_settings": {
    "format": "fbx",
    "fbx": {
      "scale": 1.0,
      "apply_modifiers": true,
      "use_mesh_edges": false,
      "use_triangles": true,
      "comment": "三角面更适合游戏引擎"
    },
    "naming_convention": {
      "prefix": "SM_",
      "suffix": "",
      "format": "{prefix}{name}{suffix}",
      "comment": "SM_表示Static Mesh"
    }
  },

  "performance": {
    "batch_size": 1,
    "comment": "同时处理的文件数，1表示串行",
    "memory_limit_gb": 16,
    "use_gpu": false,
    "comment": "Blender后台模式不支持GPU加速"
  },

  "logging": {
    "level": "INFO",
    "save_to_file": true,
    "output_dir": "输出/日志/",
    "include_timestamp": true
  }
}
